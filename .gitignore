# --- Java / Maven (missionhq-backend) ---
target/
*.jar
*.war
!.mvn/wrapper/*.jar

# --- Node / Angular (missionhq-web) ---
# missionhq-web/.gitignore covers dist, node_modules and .angular/cache

# --- IDE ---
# .idea is ignored except shared run configurations: dataSources.local.xml (DB credentials)
# and workspace.xml stay local, .idea/runConfigurations/ is versioned for the whole team.
**/.idea/*
!**/.idea/runConfigurations/
*.iml
*.iws
*.ipr

# --- OS ---
Thumbs.db
.DS_Store

# --- Local env ---
.env
.env.local

# --- Local photo storage (missionhq.storage.local.dir; uploaded user content, 30-day TTL) ---
data/

# --- Claude Code (per-machine permission allowlist) ---
**/.claude/settings.local.json
